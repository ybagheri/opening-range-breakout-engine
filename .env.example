# MetaTrader 5 connection (NEVER commit real credentials)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_SYMBOLS=US30,US500,US100
MT5_MAGIC=20240101
MT5_DEVIATION_POINTS=20

# Timezone (IANA name, e.g. America/New_York, Europe/Berlin, Asia/Tehran, UTC)
TIMEZONE=America/New_York

# Opening range (market time HH:MM)
OR_START_TIME=09:30
OR_END_TIME=09:45

# Entry window (market time HH:MM)
TRADING_START_TIME=09:45
TRADING_END_TIME=11:30

# Forced exit (market time HH:MM, empty = disabled)
FORCE_CLOSE_TIME=15:50
ALLOW_OVERNIGHT=false

# Risk
RISK_PER_TRADE_PERCENT=0.5
MAX_TRADES_PER_SYMBOL_PER_DAY=1
MAX_TOTAL_TRADES_PER_DAY=3
MAX_DAILY_LOSS_PERCENT=2.0

# Stop loss: opposite | or_width_multiple | fixed_points | atr | percent
STOP_LOSS_MODE=opposite
STOP_LOSS_VALUE=1.0
# Take profit: risk_reward | or_width_multiple | fixed_points
TAKE_PROFIT_MODE=risk_reward
TAKE_PROFIT_VALUE=2.0
RISK_REWARD=2.0

# Breakout buffer in points (0 = disabled) or percent via BREAKOUT_BUFFER_PCT_OF_OR
BREAKOUT_BUFFER_POINTS=0.0
BREAKOUT_BUFFER_PCT_OF_OR=0.0
BREAKOUT_REQUIRE_CLOSE=false
# Per-symbol point-size overrides for backtests, e.g. "US30:1.0,US500:0.25"
POINT_OVERRIDES=

# Breakeven
BREAK_EVEN_ENABLED=true
BREAK_EVEN_TRIGGER_R=1.0
BREAK_EVEN_BUFFER_POINTS=0.0

# Spread filter (points, 0 = disabled)
MAX_SPREAD_POINTS=0.0

# Modes
DRY_RUN=true
PAPER_MODE=true

# Backtest assumptions
BACKTEST_SPREAD_POINTS=2.0
BACKTEST_SLIPPAGE_POINTS=1.0
BACKTEST_COMMISSION_PER_TRADE=0.0
BACKTEST_INTRA_BAR_POLICY=conservative

# State / journal
STATE_DB_PATH=data/orb_state.sqlite
JOURNAL_DB_PATH=data/orb_journal.sqlite
LOG_LEVEL=INFO
